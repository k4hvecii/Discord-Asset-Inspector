{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2020"
    ],
    "strict": true,
    "skipLibCheck": true,
    "outFile": "plugins/betterdiscord/DiscordAssetInspector.plugin.js",
    "removeComments": false,
    "sourceMap": false
  },
  "files": [
    "src/betterdiscord.ts",
    "src/core/types.ts",
    "src/core/constants.ts",
    "src/core/utils.ts",
    "src/core/registry.ts",
    "src/scanners/webpack.ts",
    "src/scanners/dom.ts",
    "src/scanners/performance.ts",
    "src/scanners/css.ts",
    "src/ui/styles.ts",
    "src/ui/app.ts"
  ]
}
